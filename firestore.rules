// COPABET — REGRAS ÚNICAS E CONSOLIDADAS PARA O FIRESTORE.
// Cole este arquivo inteiro em Firestore Database > Regras e clique em Publicar.
// FIREBASE-CAMBISTAS.md contém somente instruções, não outra regra.
// A criação de contas no Authentication acontece no site, não neste arquivo.
// IMPORTANTE: compare com quaisquer alterações feitas no console antes de substituir.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn()
        && request.auth.uid in ['rjWeKGZpkMVrW8UynAKCwjZXklM2'];
    }

    // USUÁRIOS
    match /users/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.balance == 0
        && request.resource.data.code is string
        && request.resource.data.email is string
        && request.resource.data.name is string
        && request.resource.data.cpf is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'code', 'balance', 'name', 'cpf', 'createdAt'
        ]);
      allow update, delete: if isAdmin();
    }

    // CADASTROS DE CPF
    match /registeredCpfs/{cpf} {
      allow get: if !exists(/databases/$(database)/documents/registeredCpfs/$(cpf))
        || isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.cpf == cpf
        && cpf.matches('^[0-9]{11}$')
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          'cpf', 'name', 'phone', 'uid', 'createdAt'
        ]);
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.cpf == resource.data.cpf
        && request.resource.data.name is string
        && request.resource.data.phone is string;
      allow delete: if isAdmin();
    }

    // BILHETES
    match /bets/{betId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.cpfNormalized is string
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.picks is list
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // LIGAS E PARTIDAS MANUAIS
    match /leagues/{leagueId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /matches/{matchId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // PARTIDAS IMPORTADAS
    match /jogos/{jogoId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // MOVIMENTAÇÕES, DEPÓSITOS E CONFIGURAÇÕES
    match /balanceMovements/{movementId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
    match /deposits/{depositId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.amount >= 10
        && request.resource.data.amount <= 5000;
      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    match /siteSettings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // CAMBISTAS — incorporado às regras gerais da COPABET.
    // O titular pode consultar apenas o próprio perfil.
    // Apenas o administrador consulta todos, cadastra, altera comissão e ativa/desativa.
    // O UID do documento precisa ser o mesmo UID gerado pelo Firebase Authentication.
    match /cambistas/{cambistaUid} {
      allow get: if signedIn()
        && (request.auth.uid == cambistaUid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}